<?xml version="1.0" encoding="utf-8"?>
<!-- Nada se copia a la nube ni a otro dispositivo: los servidores llevan huellas TOFU y
     referencias a claves cifradas con el Keystore de ESTE dispositivo (no portables). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
