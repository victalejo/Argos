<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!-- El aviso salta en una clase de TLS DENTRO de bcpkix (dependencia de sshj para leer
         claves). Argos no usa TLS de BouncyCastle: SSH verifica la host key con TOFU propio.
         Se ignora solo para ese jar; en el código de Argos sigue siendo error. -->
    <issue id="TrustAllX509TrustManager">
        <ignore regexp="bcpkix-jdk18on" />
    </issue>
    <!-- libtermux.so (JNI para lanzar un proceso LOCAL) viene en el AAR de terminal-emulator
         pero se EXCLUYE del APK (packaging.jniLibs en build.gradle.kts): Argos alimenta el
         emulador con el PTY remoto y nunca la carga. Lint analiza el AAR igualmente. -->
    <issue id="Aligned16KB">
        <ignore regexp="libtermux\.so" />
    </issue>
</lint>
