      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Argos opens Terminal in your project’s local copy and starts Claude Code."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Argos abre Terminal en la copia local de tu proyecto y arranca Claude Code."
          }
