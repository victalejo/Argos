      }
    },
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Argos uses the camera to scan the QR code your Mac shows to share a server with you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Argos usa la cámara para escanear el código QR con el que el Mac te pasa un servidor."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Argos uses Face ID so only you can open your servers."
          }
