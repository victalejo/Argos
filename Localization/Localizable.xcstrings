    "Hay una operación de git a medias (%@). Termínala o cancélala en el terminal antes de restaurar." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There’s a git operation in progress (%@). Finish or abort it in the terminal before restoring."
