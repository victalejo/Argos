      }
    },
    "Argos lee tu ~/.ssh/config y las claves que referencia. Pulsa «Conceder acceso» con la carpeta .ssh abierta. Solo se pide una vez y es de solo lectura." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Argos reads your ~/.ssh/config and the keys it refers to. Click “Grant Access” with the .ssh folder open. It’s only asked once and it’s read-only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Argos lee tu ~/.ssh/config y las claves que referencia. Pulsa «Conceder acceso» con la carpeta .ssh abierta. Solo se pide una vez y es de solo lectura."
          }
        }
