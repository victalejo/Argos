    "Para los agentes quietos sin actividad desde hace %@ o más; se reanudan al escribirles." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stops the agents that have been idle for %@ or more; they resume when you write to them."
