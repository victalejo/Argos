    "Argos funciona en un entorno protegido de macOS. Concede solo lo que uses." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Argos runs in a protected macOS environment. Only grant what you use."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Argos funciona en un entorno protegido de macOS. Concede solo lo que uses."
          }
