    "Usa el %lld %% de la memoria (RAM y swap). Si se llena, el sistema empezará a cerrar procesos: detén las sesiones que no estés usando." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld%% of memory (RAM and swap) is in use. If it fills up, the system will start closing processes: stop the sessions you aren’t using."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el %lld %% de la memoria (RAM y swap). Si se llena, el sistema empezará a cerrar procesos: detén las sesiones que no estés usando."
          }
        }
      }
    },
    "Usa el %lld %% de la memoria (RAM y swap); procesos de Claude en marcha: %lld. Si se llena, el sistema empezará a cerrar procesos: detén las sesiones que no estés usando." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld%% of memory (RAM and swap) is in use; Claude processes running: %lld. If it fills up, the system will start closing processes: stop the sessions you aren’t using."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el %1$lld %% de la memoria (RAM y swap); procesos de Claude en marcha: %2$lld. Si se llena, el sistema empezará a cerrar procesos: detén las sesiones que no estés usando."
          }
