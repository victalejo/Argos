    "Guarda cada sesión como proyecto anclado a su carpeta actual" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saves each session as a project anchored to its current folder"
          }
        },
        "es" : {
